# ==============================================================================
# 1. DATABASE CONNECTION (Local Registrar MySQL Server)
# ==============================================================================
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=registrar-cvsu
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ==============================================================================
# 2. NATS BROKERS & AUTHENTICATION
# ==============================================================================
# Local NATS instance for Debezium CDC and internal faststream bridge
LOCAL_NATS_HOST=nats
LOCAL_NATS_PORT=4222

# Remote NATS instance for university-wide cross-service event mesh
REMOTE_NATS_HOST=192.168.10.130
REMOTE_NATS_PORT=4222
NATS_CREDS=/app/univ-reg.creds

# ==============================================================================
# 3. LOCAL CDC JETSTREAM (Debezium -> FastStream Bridge)
# ==============================================================================
# Stream name on local NATS where Debezium publishes outbox events
LOCAL_CDC_STREAM=LocalCDCStream

# Comma-separated subject patterns registered on LocalCDCStream
LOCAL_CDC_STREAM_SUBJECTS=academics.enrollment.main,academics.enrollment.main.>,academics.enrollment.students.main.>

# Inbound subject consumed by FastStream from LocalCDCStream
LOCAL_CDC_CONSUME_SUBJECT=academics.enrollment.main.student.profile

# Durable consumer name for FastStream to track stream sequence
LOCAL_CDC_CONSUMER_NAME=faststream_cdc_bridge

# ==============================================================================
# 4. REMOTE OUTBOUND PUBLISHING (FastStream -> Remote NATS)
# ==============================================================================
# Remote subjects where live student profile changes are published
TARGET_STUDENT_SUBJECT=academics.enrollment.students.main.profile
MAIN_STUDENT_SUBJECT=academics.enrollment.main.student.profile

# Remote subject where document request milestone responses are published
DOC_RESPONSE_SUBJECT=academics.enrollment.documents.students.response.created

# ==============================================================================
# 5. REMOTE INBOUND DOCUMENT REQUEST STREAM (Remote NATS -> Ingestion Worker)
# ==============================================================================
# Remote JetStream name containing student document request events
DOC_REQUEST_STREAM=DOCUMENTS

# Remote subject filter for incoming document request creation events
DOC_REQUEST_SUBJECT=academics.enrollment.documents.students.request.created

# Durable consumer name for document request worker to prevent replay
DOC_REQUEST_CONSUMER=registrar_doc_request_sync
