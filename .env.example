# ==========================================
# Student Profile CDC & Streaming Configuration
# ==========================================

# NATS Connection URLs
LOCAL_NATS_URL=nats://nats:4222
REMOTE_NATS_URL=nats://192.168.10.130:4222
NATS_CREDS=/app/univ-reg.creds

# Target MySQL Database Connection (Local Registrar App)
MYSQL_URL=mysql+pymysql://root:@host.docker.internal/registrar-cvsu

# Local CDC JetStream Configuration
LOCAL_CDC_STREAM=LocalCDCStream

# Remote Outbound Subjects (Student Profile Outbox Publishing)
TARGET_STUDENT_SUBJECT=academics.enrollment.students.main.profile
MAIN_STUDENT_SUBJECT=academics.enrollment.main.student.profile
DOC_RESPONSE_SUBJECT=academics.enrollment.documents.students.response.created

# Remote Inbound Document Request Stream & Consumer
DOC_REQUEST_STREAM=DOCUMENTS
DOC_REQUEST_SUBJECT=academics.enrollment.documents.students.request.created
DOC_REQUEST_CONSUMER=registrar_doc_request_sync
