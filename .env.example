# ==============================================================================
# 0. UNIVERSITY TAXONOMY NAMESPACE (<domain>.<system>)
# ==============================================================================
STREAM_DOMAIN_SYSTEM=academic.univ-reg

# ==============================================================================
# 1. DATABASE CONNECTION (Local Registrar MySQL Server)
# ==============================================================================
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=registrar-cvsu
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ==============================================================================
# 2. NATS BROKERS & AUTHENTICATION
# ==============================================================================
# Local NATS container for Debezium CDC -> FastStream internal bridge
LOCAL_NATS_HOST=nats
LOCAL_NATS_PORT=4222

# Remote NATS cluster for university event mesh
REMOTE_NATS_HOST=192.168.10.130
REMOTE_NATS_PORT=4222
NATS_CREDS=/app/univ-reg.creds

# ==============================================================================
# 3. REMOTE INBOUND LEGACY STUDENT STREAM (Remote NATS -> Ingestion Worker)
# ==============================================================================
LEGACY_STUDENT_STREAM=ENROLLMENT
LEGACY_STUDENT_SUBJECT=acad.enrollment.record.>
LEGACY_STUDENT_CONSUMER=registrar_legacy_student_sync
LEGACY_STUDENT_BATCH_SIZE=1000
LEGACY_STUDENT_ACK_WAIT=60

# ==============================================================================
# 4. REMOTE INBOUND DOCUMENT REQUEST STREAM (Remote NATS -> Ingestion Worker)
# ==============================================================================
DOC_REQUEST_STREAM=DOCUMENTS
DOC_REQUEST_SUBJECT=academics.enrollment.documents.students.request.created
DOC_REQUEST_CONSUMER=registrar_doc_request_sync
DOC_REQUEST_BATCH_SIZE=100
DOC_REQUEST_ACK_WAIT=30

# ==============================================================================
# 5. REMOTE OUTBOUND DOCUMENT RESPONSE STREAM (FastStream Bridge -> Remote NATS)
# ==============================================================================
DOC_RESPONSE_SUBJECT=acad.studentportal.request.document.updated
